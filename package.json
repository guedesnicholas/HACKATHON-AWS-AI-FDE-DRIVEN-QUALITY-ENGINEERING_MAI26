{
  "name": "hackathon-pop-doce-qe",
  "version": "0.1.0",
  "private": true,
  "description": "Este arquivo define os comandos e dependências da automação do Hackathon.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tests-local/*.test.cjs",
